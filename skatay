import time as time
import RPi.GPIO as GPIO
import matplotlib.pyplot as plt
dac = [8, 11, 7, 1, 0, 5, 12, 6]
comp = 14
troyka = 13
GPIO.setmode(GPIO.BCM)
GPIO.setup(dac, GPIO.OUT)
GPIO.setup(troyka, GPIO.OUT, initial=GPIO.HIGH)
GPIO.setup(comp, GPIO.IN)
def convert(chislo):
    ret = []
    while chislo != 0:
        ret.append(chislo % 2)
        chislo = chislo // 2
    for i in range(8 - len(ret)):
        ret.append(0)
    return ret[::-1]

def adc():
    k = 0
    for i in range(7, -1, -1):
        k += 2 ** i
        GPIO.output(dac, convert(k))
        time.sleep(0.005)
        if GPIO.input(comp) == 1:
            k -= 2 ** i
    return k
exp_time = 0

try:
    data = []
    
    st_time = time.time()
    
    while True:
        number = adc()
        if number != 0:
            print(number, "{:.2f} Volts".format(3.3 * number / 256))
            data.append(number)
        if number == 210:
          GPIO. output(troyka, 0)
          break
    while True:
        number = adc()
        if number != 0:
            print(number, "{:.2f} Volts".format(3.3 * number / 256))
            data.append(number)
        if number == 176:
            end_time = time.time()

            exp_time =end_time - st_time
            print(exp_time)
            print('v = ', 8*0.05, "Gz")
            data_str = [str(i) for i in data]
            with open("data.txt", "w") as outfile:
                outfile.write("\n".join(data_str))
    
            plt.plot(data)
            plt.show()
            break
        

        
finally:
    GPIO.output(dac, GPIO.LOW)
    GPIO.cleanup()
